apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: nextcloud-db
  namespace: {{ nextcloud_namespace }}
spec:
  instances: {{ nextcloud_postgresql_replicas }}
  primaryUpdateStrategy: unsupervised
  storage:
    size: {{ nextcloud_postgresql_size }}
    storageClass: {{ nextcloud_postgresql_storage_class }}
  bootstrap:
    initdb:
      database: {{ nextcloud_postgresql_database }}
      owner: {{ nextcloud_postgresql_username }}
      secret:
        name: nextcloud-db-credentials
{% if nextcloud_postgresql_override_resources %}
  resources:
    requests:
      memory: {{ nextcloud_postgresql_resources_requests_memory }}
      cpu: {{ nextcloud_postgresql_resources_requests_cpu }}
    limits:
      memory: {{ nextcloud_postgresql_resources_limits_memory }}
      cpu: {{ nextcloud_postgresql_resources_limits_cpu }}
{% endif %}
