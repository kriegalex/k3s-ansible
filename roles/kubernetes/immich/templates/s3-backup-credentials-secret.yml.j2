---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ immich_postgresql_backup_credentials_secret_name }}"
  namespace: "{{ immich_namespace }}"
type: Opaque
data:
  ACCESS_KEY_ID: "{{ immich_postgresql_backup_s3_access_key | b64encode }}"
  ACCESS_SECRET_KEY: "{{ immich_postgresql_backup_s3_secret_key | b64encode }}"
