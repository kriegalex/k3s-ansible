image:
  repository: {{ radarr_image_repository }}
  tag: {{ radarr_image_tag }}
  pullPolicy: {{ radarr_image_pull_policy }}

resources:
  limits:
    memory: {{ radarr_resources_limits_memory }}
    cpu: {{ radarr_resources_limits_cpu }}
  requests:
    memory: {{ radarr_resources_requests_memory }}
    cpu: {{ radarr_resources_requests_cpu }}

persistence:
  enabled: {{ radarr_persistence_enabled | lower }}
{% if radarr_persistence_enabled %}
{% if radarr_existing_claim is defined %}
  existingClaim: {{ radarr_existing_claim }}
{% else %}
  storageClass: {{ radarr_storage_class }}
  size: {{ radarr_storage_size }}
{% endif %}
  accessMode: {{ radarr_access_mode }}
{% endif %}
{% if radarr_additional_volumes %}
  # -- if you need any additional volumes, you can define them here
  additionalVolumes:
{% for volume in radarr_additional_volumes %}
    - name: {{ volume.name }}
      persistentVolumeClaim:
        claimName: {{ volume.claim_name }}
{% endfor %}
  # -- if you need any additional volume mounts, you can define them here
  additionalMounts:
{% for volume in radarr_additional_volumes %}
    - name: {{ volume.name }}
      mountPath: {{ volume.mount_path }}
{% endfor %}
{% endif %}

service:
  type: {{ radarr_service_type }}
  port: {{ radarr_service_port }}

ingress:
  enabled: {{ radarr_ingress_enabled | lower }}
  annotations:
    kubernetes.io/ingress.class: {{ global_nginx_class }}
{% if radarr_ingress_tls_enabled %}
    cert-manager.io/cluster-issuer: {{ global_cluster_issuer }}
{% endif %}
  hosts:
    - host: {{ radarr_host }}
      paths:
        - path: /
          pathType: Prefix
{% if radarr_ingress_tls_enabled %}
  tls:
    - secretName: radarr-tls
      hosts:
        - {{ radarr_host }}
{% endif %}

{% if radarr_anti_affinity_enabled %}
# Add affinity rules for Radarr to avoid other pods
affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
    - weight: {{ radarr_anti_affinity_weight | int }}
      podAffinityTerm:
        labelSelector:
          matchExpressions:
          - key: app.kubernetes.io/name
            operator: In
            values:
            - {{ radarr_anti_affinity_target_name }}
        namespace: {{ radarr_anti_affinity_target_namespace }}
        topologyKey: kubernetes.io/hostname
{% endif %}
