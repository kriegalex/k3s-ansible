apiVersion: v1
kind: PersistentVolume
metadata:
  name: "{{ item.name }}"
  labels:
    content: {{ item.name }}
  annotations:
    description: "{{ item.description }}"
spec:
  capacity:
    storage: "{{ item.size }}"
  accessModes:
    - "{{ item.access_mode | default(nfs_pvc_access_mode) }}"
  persistentVolumeReclaimPolicy: "{{ item.reclaim_policy | default(nfs_pvc_reclaim_policy) }}"
  storageClassName: "nfs-static"
  nfs:
    server: "{{ item.server | default(nfs_pvc_server) }}"
    path: "{{ item.path | default(nfs_pvc_root_path ~ '/' ~ item.name) }}"
  mountOptions:
    - nfsvers={{ nfs_version }}
    - hard
    - noatime
