---
# n8n Helm Chart Values File
# Generated by Ansible

log:
  level: {{ n8n_log_level | quote }}

timezone: {{ n8n_timezone | quote }}

{% if n8n_encryption_key | length > 0 %}
encryptionKey: {{ n8n_encryption_key | quote }}
{% endif %}

{% if n8n_existing_encryption_key_secret | length > 0 %}
existingEncryptionKeySecret: {{ n8n_existing_encryption_key_secret | quote }}
{% endif %}

gracefulShutdownTimeout: {{ n8n_grace_shutdown_timeout }}

db:
  type: {{ n8n_db_type | quote }}
  tablePrefix: {{ n8n_table_prefix | quote }}

{% if n8n_db_type == 'postgresdb' %}
# PostgreSQL configuration
{% if n8n_postgresql_enabled and not n8n_use_external_postgresql %}
postgresql:
  enabled: true
  auth:
    username: "n8n"
    database: "n8n"
{% endif %}

{% if n8n_use_external_postgresql %}
externalPostgresql:
  host: {{ n8n_external_postgresql.host | quote }}
  port: {{ n8n_external_postgresql.port }}
  username: {{ n8n_external_postgresql.username | quote }}
  {% if n8n_external_postgresql.password | length > 0 and not n8n_external_postgresql.existing_secret %}
  password: {{ n8n_external_postgresql.password | quote }}
  {% endif %}
  database: {{ n8n_external_postgresql.database | quote }}
  {% if n8n_external_postgresql.existing_secret | length > 0 %}
  existingSecret: {{ n8n_external_postgresql.existing_secret | quote }}
  {% endif %}
{% endif %}
{% endif %}

{% if n8n_worker_mode == 'queue' %}
# Redis configuration (needed for queue mode)
{% if n8n_redis_enabled and not n8n_use_external_redis %}
redis:
  enabled: true
  architecture: "standalone"
  master:
    persistence:
      enabled: false
{% endif %}

{% if n8n_use_external_redis %}
externalRedis:
  host: {{ n8n_external_redis.host | quote }}
  port: {{ n8n_external_redis.port }}
  {% if n8n_external_redis.username | length > 0 %}
  username: {{ n8n_external_redis.username | quote }}
  {% endif %}
  {% if n8n_external_redis.password | length > 0 and not n8n_external_redis.existing_secret %}
  password: {{ n8n_external_redis.password | quote }}
  {% endif %}
  {% if n8n_external_redis.existing_secret | length > 0 %}
  existingSecret: {{ n8n_external_redis.existing_secret | quote }}
  {% endif %}
{% endif %}
{% endif %}

# Worker configuration
worker:
  mode: {{ n8n_worker_mode | quote }}
  concurrency: {{ n8n_worker_concurrency }}
  count: {{ n8n_worker_count }}
  autoscaling:
    enabled: {{ n8n_worker_autoscaling_enabled | lower }}
  resources:
    requests:
      cpu: {{ n8n_worker_resources.requests.cpu | quote }}
      memory: {{ n8n_worker_resources.requests.memory | quote }}
    limits:
      cpu: {{ n8n_worker_resources.limits.cpu | quote }}
      memory: {{ n8n_worker_resources.limits.memory | quote }}

# Main node configuration
main:
  count: {{ n8n_main_count }}
  resources:
    requests:
      cpu: {{ n8n_main_resources.requests.cpu | quote }}
      memory: {{ n8n_main_resources.requests.memory | quote }}
    limits:
      cpu: {{ n8n_main_resources.limits.cpu | quote }}
      memory: {{ n8n_main_resources.limits.memory | quote }}

# Webhook configuration
webhook:
  mode: {{ n8n_webhook_mode | quote }}
  count: {{ n8n_webhook_count }}
  {% if n8n_webhook_url | length > 0 %}
  url: {{ n8n_webhook_url | quote }}
  {% endif %}
  autoscaling:
    enabled: {{ n8n_webhook_autoscaling_enabled | lower }}
  resources:
    requests:
      cpu: {{ n8n_webhook_resources.requests.cpu | quote }}
      memory: {{ n8n_webhook_resources.requests.memory | quote }}
    limits:
      cpu: {{ n8n_webhook_resources.limits.cpu | quote }}
      memory: {{ n8n_webhook_resources.limits.memory | quote }}

# Ingress configuration
ingress:
  enabled: {{ n8n_ingress_enabled | lower }}
  {% if n8n_ingress_enabled %}
  annotations: 
    {% for key, value in n8n_ingress_annotations.items() %}
    {{ key }}: {{ value | quote }}
    {% endfor %}
  hosts:
    - host: {{ n8n_ingress_host | quote }}
      paths:
        - path: {{ n8n_ingress_path | quote }}
          pathType: {{ n8n_ingress_path_type | quote }}
  {% if n8n_ingress_tls_enabled %}
  tls:
    - hosts:
        - {{ n8n_ingress_host | quote }}
      secretName: {{ n8n_ingress_tls_secret_name | quote }}
  {% endif %}
  {% endif %}

# API configuration
api:
  enabled: {{ n8n_api_enabled | lower }}

# Workflow history
workflowHistory:
  enabled: {{ n8n_workflow_history_enabled | lower }}
  pruneTime: {{ n8n_workflow_history_prune_time }}

# Custom values overrides
{% if n8n_custom_values | length > 0 %}
{{ n8n_custom_values | to_nice_yaml }}
{% endif %}
