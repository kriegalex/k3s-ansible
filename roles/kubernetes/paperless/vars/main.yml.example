# group_vars/ansible_local/paperless.yml
---
# Base
paperless_enabled: true
paperless_namespace: paperless
paperless_chart_version: "0.23.0"
paperless_image_tag: "2.14.7"

# Paperless
paperless_app_trusted_proxies: "10.42.0.0/16"
paperless_admin_user: "admin"
paperless_admin_mail: "admin@example.com"
paperless_app_filename_format: "{created_year}/{correspondent}/{title}"

# Persistence
paperless_nfs_server: 10.0.0.2
paperless_media_nfs_claim_name: "nfs-paperless-media"
paperless_media_nfs_path: "/mnt/user/paperless/media"
paperless_consume_nfs_claim_name: "nfs-paperless-consume"
paperless_consume_nfs_path: "/mnt/user/paperless/consume"
paperless_export_nfs_claim_name: "nfs-paperless-export"
paperless_export_nfs_path: "/mnt/user/paperless/export"

# internal | cloudnativepg
paperless_database_source: "cloudnativepg"
paperless_postgresql_create_cluster: true
paperless_postgresql_storage_class: "longhorn-single-replica"

# PostgreSQL migration settings
paperless_migrate_database: false
paperless_migrate_source_namespace: "default"
paperless_migrate_source_db_name: "paperless-db"

# S3 Backup Credentials
paperless_postgresql_backup_enabled: false
paperless_postgresql_backup_s3_endpoint: "http://10.0.0.7:8010"
paperless_postgresql_backup_s3_bucket: "paperless-backups"
paperless_postgresql_backup_s3_access_key: "{{ vault_cnpg_backup_s3_access_key }}"
paperless_postgresql_backup_s3_secret_key: "{{ vault_cnpg_backup_s3_secret_key }}"
