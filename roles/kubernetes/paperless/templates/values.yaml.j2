image:
  tag: {{ paperless_image_tag }}

env:
  TZ: "{{ paperless_app_timezone }}"
  PAPERLESS_SECRET_KEY: {{ vault_paperless_secret_key }}
  PAPERLESS_TRUSTED_PROXIES: "{{ paperless_app_trusted_proxies }}"
  PAPERLESS_DATA_DIR: "/usr/src/paperless/media"
  PAPERLESS_FILENAME_FORMAT: "{{ paperless_app_filename_format }}"
{% if paperless_app_consumer_polling_enabled %}
  PAPERLESS_CONSUMER_POLLING: "{{ paperless_app_consumer_polling }}"
{% endif %}
  PAPERLESS_CONSUMER_RECURSIVE: {{ paperless_app_consumer_recursive | lower }}
  PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS: {{ paperless_app_consumer_subdirs_as_tags | lower }}
  PAPERLESS_OCR_USER_ARGS: '{{ paperless_app_ocr_user_args }}'
  PAPERLESS_ADMIN_USER: "{{ paperless_admin_user }}"
  PAPERLESS_ADMIN_MAIL: "{{ paperless_admin_mail }}"
  PAPERLESS_ADMIN_PASSWORD: "{{ vault_paperless_admin_password }}"
{% if paperless_postgresql_source == 'cloudnativepg' %}
  PAPERLESS_DBENGINE: postgresql
  PAPERLESS_DBHOST: paperless-db-rw
  PAPERLESS_DBNAME: {{ paperless_postgresql_name }}
  PAPERLESS_DBUSER: {{ paperless_postgresql_user }}
  PAPERLESS_DBPASS: {{ vault_paperless_db_password }}
{% endif %}

ingress:
  main:
    enabled: {{ paperless_ingress_enabled }}
    ingressClassName: "{{ paperless_ingress_class_name }}"
    annotations:
{% if paperless_ingress_annotations %}
      {{ paperless_ingress_annotations | to_nice_yaml(indent=2) | indent(6) }}
{% endif %}
    hosts:
      - host: {{ paperless_app_domain }}
        paths:
          - path: /
    tls:
      - secretName: paperless-ingress-tls
        hosts:
          - {{ paperless_app_domain }}

persistence:
  data:
    enabled: false # merged with media via ENV variable
  media:
    enabled: {{ paperless_persistence_media_enabled }}
    retain: true
{% if paperless_media_claim_name | length > 0 %}
    # Either use an existing claim
    existingClaim: "{{ paperless_media_claim_name }}"
{% else %}
    # Or use a storage class
    storageClass: "{{ paperless_media_storage_class }}"
    size: "{{ paperless_media_storage_size }}"
    accessMode: "{{ paperless_media_access_mode }}"
{% endif %}
  consume:
    enabled: {{ paperless_persistence_consume_enabled }}
    retain: true
{% if paperless_consume_claim_name | length > 0 %}
    existingClaim: "{{ paperless_consume_claim_name }}"
{% else %}
    storageClass: "{{ paperless_consume_storage_class }}"
    size: "{{ paperless_consume_storage_size }}"
    accessMode: "{{ paperless_consume_access_mode }}"
{% endif %}
  export:
    enabled: {{ paperless_persistence_export_enabled }}
    retain: true
{% if paperless_export_claim_name | length > 0 %}
    existingClaim: "{{ paperless_export_claim_name }}"
{% else %}
    storageClass: "{{ paperless_export_storage_class }}"
    size: "{{ paperless_export_storage_size }}"
    accessMode: "{{ paperless_export_access_mode }}"
{% endif %}

postgresql:
  enabled: {{ paperless_postgresql_source == 'internal' }}
  auth:
    username: {{ paperless_postgresql_user }}
    database: {{ paperless_postgresql_name }}
    password: {{ vault_paperless_db_password }}
  primary:
    persistence:
      enabled: true
      storageClass: "{{ paperless_postgresql_storage_class }}"
{% if paperless_affinity_enabled %}
  # Add affinity rules for Redis to co-locate with Nextcloud
  affinity:
    podAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
      - weight: {{ paperless_affinity_weight | int }}
        podAffinityTerm:
          labelSelector:
            matchExpressions:
            - key: app.kubernetes.io/instance
              operator: In
              values:
              - {{ paperless_release_name }}
          topologyKey: kubernetes.io/hostname
{% endif %}

redis:
  enabled: true
  architecture: {{ paperless_redis_architecture }}
  auth:
    password: {{ paperless_redis_password }}
  master:
    count: {{ paperless_redis_master_count }}
{% if paperless_affinity_enabled %}
    # Add affinity rules for Redis to co-locate with Nextcloud
    affinity:
      podAffinity:
        preferredDuringSchedulingIgnoredDuringExecution:
        - weight: {{ paperless_affinity_weight | int }}
          podAffinityTerm:
            labelSelector:
              matchExpressions:
              - key: app.kubernetes.io/instance
                operator: In
                values:
                - {{ paperless_release_name }}
            topologyKey: kubernetes.io/hostname
{% endif %}

resources:
  limits:
    memory: {{ paperless_resources_limits_memory }}
    cpu: {{ paperless_resources_limits_cpu }}
  requests:
    memory: {{ paperless_resources_requests_memory }}
    cpu: {{ paperless_resources_requests_cpu }}

{% if paperless_affinity_enabled or paperless_anti_affinity_enabled %}
# Add affinity rules for Redis to co-locate with Nextcloud
affinity:
{% if paperless_affinity_enabled %}
  podAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
    - weight: {{ paperless_affinity_weight | int }}
      podAffinityTerm:
        labelSelector:
          matchExpressions:
          - key: app.kubernetes.io/instance
            operator: In
            values:
            - {{ paperless_release_name }}
        topologyKey: kubernetes.io/hostname
{% endif %}
{% if paperless_anti_affinity_enabled %}
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
    - weight: {{ paperless_anti_affinity_weight | int }}
      podAffinityTerm:
        labelSelector:
          matchExpressions:
          - key: app.kubernetes.io/name
            operator: In
            values:
            - {{ paperless_anti_affinity_target_name }}
        namespaces: 
          - {{ paperless_anti_affinity_target_namespace }}
        topologyKey: kubernetes.io/hostname
{% endif %}
{% endif %}
