# Bluesky PDS Helm Values
# Generated by Ansible

{% if bluesky_pds_image_tag is defined %}
image:
  tag: {{ bluesky_pds_image_tag }}
{% endif %}

# PDS Service configuration
pds:
  serverDid: {{ bluesky_pds_server_did }}
  existingSecret: "{{ bluesky_pds_secret_name }}"
  serviceHandleDomains: {{ bluesky_pds_service_handle_domains | to_json }}
  inviteRequired: {{ bluesky_pds_invite_required | default(false) | lower }}
  
  {% if bluesky_pds_moderator_enabled | default(true) and bluesky_pds_moderator_handle is defined %}
  moderator:
    enabled: true
    handle: "{{ bluesky_pds_moderator_handle }}"
  {% endif %}

# Persistence configuration
persistence:
  enabled: {{ bluesky_pds_persistence_enabled | default(true) | lower }}
  {% if bluesky_pds_persistence_storage_class | default(false) %}
  storageClass: "{{ bluesky_pds_persistence_storage_class }}"
  {% endif %}
  size: {{ bluesky_pds_persistence_size | default('10Gi') }}

{% if bluesky_pds_resources_limits_memory is defined or bluesky_pds_resources_requests_memory is defined %}
resources:
  {% if bluesky_pds_resources_limits_memory is defined or bluesky_pds_resources_limits_cpu is defined %}
  limits:
    {% if bluesky_pds_resources_limits_memory is defined %}
    memory: {{ bluesky_pds_resources_limits_memory }}
    {% endif %}
    {% if bluesky_pds_resources_limits_cpu is defined %}
    cpu: {{ bluesky_pds_resources_limits_cpu }}
    {% endif %}
  {% endif %}
  {% if bluesky_pds_resources_requests_memory is defined or bluesky_pds_resources_requests_cpu is defined %}
  requests:
    {% if bluesky_pds_resources_requests_memory is defined %}
    memory: {{ bluesky_pds_resources_requests_memory }}
    {% endif %}
    {% if bluesky_pds_resources_requests_cpu is defined %}
    cpu: {{ bluesky_pds_resources_requests_cpu }}
    {% endif %}
  {% endif %}
{% endif %}

# Ingress configuration
ingress:
  enabled: true
  hostname: {{ bluesky_pds_fqdn }}
  annotations:
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: letsencrypt-prod
  tls:
    - secretName: bluesky-pds-tls
      hosts:
        - {{ bluesky_pds_fqdn }}

{% if bluesky_pds_smtp_enabled | default(false) %}
# Mail configuration
mail:
  enabled: true
  host: "{{ bluesky_pds_smtp_host }}"
  port: {{ bluesky_pds_smtp_port | int }}
  username: "{{ bluesky_pds_smtp_user }}"
  password: "{{ bluesky_pds_smtp_password }}"
  fromAddress: "{{ bluesky_pds_smtp_from_address }}"
  secure: {{ bluesky_pds_smtp_secure | default(true) | lower }}
{% endif %}

{% if bluesky_pds_crawler_enabled | default(false) %}
# Crawler configuration
crawler:
  enabled: true
  serviceDid: "{{ bluesky_pds_crawler_service_did }}"
{% endif %}

{% if bluesky_pds_backups_enabled | default(false) %}
# Backup configuration
backup:
  enabled: true
  schedule: "{{ bluesky_pds_backups_schedule }}"
  retention: {{ bluesky_pds_backups_retention }}
  persistence:
    enabled: true
    {% if bluesky_pds_backups_storage_class | default(false) %}
    storageClass: "{{ bluesky_pds_backups_storage_class }}"
    {% elif bluesky_pds_persistence_storage_class | default(false) %}
    storageClass: "{{ bluesky_pds_persistence_storage_class }}"
    {% endif %}
    size: {{ bluesky_pds_backups_size }}
{% endif %}

{% if bluesky_pds_domain_verification_enabled | default(true) %}
# Domain verification configuration
domainVerification:
  enabled: true
  recordName: "{{ bluesky_pds_verification_record_name | default('_atproto') }}"
  recordText: "{{ bluesky_pds_verification_record_text }}"
{% endif %}
