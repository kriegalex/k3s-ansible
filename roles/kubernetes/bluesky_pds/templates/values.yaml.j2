# Default values for bluesky-pds.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.
# Generated by Ansible

replicaCount: {{ bluesky_pds_replica_count | default(1) }}

image:
  repository: ghcr.io/bluesky-social/pds
  pullPolicy: IfNotPresent
{% if bluesky_pds_image_tag is defined %}
  tag: {{ bluesky_pds_image_tag }}
{% endif %}

pds:
  config:
    # -- The public hostname of your PDS
    hostname: {{ bluesky_pds_fqdn }}
    secrets:
{% if bluesky_pds_secret_name is defined %}
      # -- Set the value for existingSecret to use a pre-created secret
      existingSecret: "{{ bluesky_pds_secret_name }}"
{% else %}
      # -- Output of `openssl rand --hex 16`
      jwtSecret: "{{ bluesky_pds_jwt_secret | default('') }}"
      # -- Output of `openssl rand --hex 16`
      adminPassword: "{{ bluesky_pds_admin_password | default('') }}"
      # -- Output of `openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32`
      plcRotationKey: "{{ bluesky_pds_plc_rotation_key_secret | default('') }}"
      # -- Example: `smtps://user:password@smtp.example.com:465/`
      emailSmtpUrl: "{{ bluesky_pds_email_smtp_url | default('') }}"
{% endif %}
    dataDir: "/pds"
    blobstoreLocation: "/pds/blocks"
    didPlcUrl: "https://plc.directory"
    bskyAppViewUrl: "https://api.bsky.app"
    bskyAppViewDid: "did:web:api.bsky.app"
    reportSvcUrl: "https://mod.bsky.app"
    reportSvcDid: "did:plc:ar7c4by46qjdydhdevvrndac"
    crawlers: "https://bsky.network"
    # -- From address for emails sent
    pdsEmailFromAddress: "{{ bluesky_pds_smtp_from_address | default('') }}"
    
  # -- Persistent storage settings
  dataStorage:
    # -- How large of a PVC to make
    size: {{ bluesky_pds_persistence_size | default('10Gi') }}
    # -- Where to mount the PVC. Make sure it matches pds.config.dataDir!
    mountPath: "/pds"
    # -- Storage class to use. Defaults to the cluster default.
{% if bluesky_pds_persistence_storage_class is defined %}
    storageClass: "{{ bluesky_pds_persistence_storage_class }}"
{% else %}
    storageClass: null
{% endif %}
    # -- Selector for persistent disk
    selector: null

imagePullSecrets: []
nameOverride: ""
fullnameOverride: ""

serviceAccount:
  # -- Specifies whether a service account should be created
  create: {{ bluesky_pds_service_account_create | default(true) | lower }}
  # -- Annotations to add to the service account
{% if bluesky_pds_service_account_annotations is defined %}
  annotations: {{ bluesky_pds_service_account_annotations | to_json }}
{% else %}
  annotations: {}
{% endif %}
  # -- The name of the service account to use.
  # If not set and create is true, a name is generated using the fullname template
{% if bluesky_pds_service_account_name is defined %}
  name: "{{ bluesky_pds_service_account_name }}"
{% else %}
  name: ""
{% endif %}

{% if bluesky_pds_pod_annotations is defined %}
podAnnotations: {{ bluesky_pds_pod_annotations | to_json }}
{% else %}
podAnnotations: {}
{% endif %}

{% if bluesky_pds_pod_security_context is defined %}
podSecurityContext: {{ bluesky_pds_pod_security_context | to_json }}
{% else %}
podSecurityContext: {}
{% endif %}

{% if bluesky_pds_security_context is defined %}
securityContext: {{ bluesky_pds_security_context | to_json }}
{% else %}
securityContext: {}
{% endif %}

service:
  type: {{ bluesky_pds_service_type | default('ClusterIP') }}
  port: {{ bluesky_pds_service_port | default(3000) }}

ingress:
  enabled: {{ bluesky_pds_ingress_enabled | default(false) | lower }}
  className: {{ bluesky_pds_ingress_class_name | default('') | to_json }}
{% if bluesky_pds_ingress_annotations is defined %}
  annotations: {{ bluesky_pds_ingress_annotations | to_json }}
{% else %}
  annotations: {}
{% endif %}
  hosts:
    - host: {{ bluesky_pds_fqdn }}
      paths:
        - path: /
          pathType: Prefix
    - host: "*.{{ bluesky_pds_fqdn }}"
      paths:
        - path: /
          pathType: Prefix
{% if bluesky_pds_tls_enabled | default(false) %}
  tls:
    - secretName: {{ bluesky_pds_tls_secret_name | default('bluesky-pds-tls') }}
      hosts:
        - {{ bluesky_pds_fqdn }}
        - "*.{{ bluesky_pds_fqdn }}"
{% else %}
  tls: []
{% endif %}

{% if bluesky_pds_resources_limits_memory is defined or bluesky_pds_resources_requests_memory is defined %}
resources:
{% if bluesky_pds_resources_limits_memory is defined or bluesky_pds_resources_limits_cpu is defined %}
  limits:
{% if bluesky_pds_resources_limits_memory is defined %}
    memory: {{ bluesky_pds_resources_limits_memory }}
{% endif %}
{% if bluesky_pds_resources_limits_cpu is defined %}
    cpu: {{ bluesky_pds_resources_limits_cpu }}
{% endif %}
{% endif %}
{% if bluesky_pds_resources_requests_memory is defined or bluesky_pds_resources_requests_cpu is defined %}
  requests:
{% if bluesky_pds_resources_requests_memory is defined %}
    memory: {{ bluesky_pds_resources_requests_memory }}
{% endif %}
{% if bluesky_pds_resources_requests_cpu is defined %}
    cpu: {{ bluesky_pds_resources_requests_cpu }}
{% endif %}
{% endif %}
{% else %}
resources: {}
{% endif %}

{% if bluesky_pds_node_selector is defined %}
nodeSelector: {{ bluesky_pds_node_selector | to_json }}
{% else %}
nodeSelector: {}
{% endif %}

{% if bluesky_pds_tolerations is defined %}
tolerations: {{ bluesky_pds_tolerations | to_json }}
{% else %}
tolerations: []
{% endif %}

{% if bluesky_pds_affinity is defined %}
affinity: {{ bluesky_pds_affinity | to_json }}
{% else %}
affinity: {}
{% endif %}
